  place-items: center;
  margin-right: 5%;
}
.portal { position: absolute; border-radius: 50%; transform: rotate(-25deg); }
.portal-back {
  width: 220px; height: 290px;
  border: 14px solid #2c897e;
  box-shadow: 0 0 30px #4ee5d455;
}
.portal-front {
  width: 185px; height: 250px;
  border: 8px solid var(--cyan);
  box-shadow: 0 0 45px #5ee7df88, inset 0 0 40px #5ee7df66;
}
.planet {
  position: absolute; top: 20px; right: 40px;
  width: 25px; height: 25px; border-radius: 50%;
