}
.hero-copy { max-width: 550px; z-index: 1; }
.eyebrow {
  color: var(--cyan);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}
h1, h2 { font-family: Orbitron, Inter, sans-serif; }
h1 { font-size: clamp(42px, 6vw, 76px); line-height: 1.04; margin: 18px 0; }
h1 span, h2 span { color: var(--lime); }
.hero-text { color: var(--muted); font-size: 14px; line-height: 1.8; max-width: 450px; }
.primary-button, .search-button {
  display: inline-block;
  background: var(--lime);
  color: #11190a;
  border: 0;
  border-radius: 4px;
  padding: 15px 18px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
  text-decoration: none;
  cursor: pointer;
}
.primary-button { margin-top: 18px; }
.hero-art {
  width: 350px;
  height: 320px;
  position: relative;
