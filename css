css = """* { box-sizing: border-box; }

:root {
  --bg: #080d16;
  --panel: #142334;
  --lime: #b7f34a;
  --cyan: #5ee7df;
  --text: #f3f7f8;
  --muted: #91a2b2;
  --line: #263747;
}

html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Inter, Arial, sans-serif;
}

.topbar {
  min-height: 76px;
  padding: 0 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--line);
}
.brand {
  display: flex;
  align-items: center;
  gap: 13px;
  color: white;
  text-decoration: none;
  font-size: 10px;
  letter-spacing: 2px;
}
.brand-mark {
  color: var(--lime);
  border: 1px solid #6f9b37;
  border-radius: 8px;
  padding: 8px;
  font: 800 19px Orbitron, sans-serif;
}
.brand b { color: var(--lime); }
.api-link, footer a {
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 1px;
  text-decoration: none;
}
main { max-width: 1250px; margin: auto; padding: 0 35px; }

.hero {
  min-height: 460px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 55px 4% 75px;
